modules = ["bash", "nix"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run program"

[[workflows.workflow]]
name = "Run program"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gcc main.c list.c -o main_prog && ./main_prog"

[workflows.workflow.metadata]
outputType = "console"
